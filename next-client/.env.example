# Copy to .env.local for local development: cp .env.example .env.local
#
# Integrations with an empty key run MOCKED (see src/lib/integrations.ts):
# Postmark logs emails to the console, Stripe fakes products/subscriptions,
# Slack serves a demo workspace, and analytics is a no-op.

# ---- Required ----------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=userdata

NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXT_AUTH=

# Shared secret for POST /api/cron/hourly-mail-sender (Authorization: Bearer <secret>)
CRON_SECRET=

# ---- Optional: OAuth sign-in (providers without an ID are hidden) -----------
# Callback URL: <NEXTAUTH_URL>/api/auth/callback/<provider>
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=
FACEBOOK_ID=
FACEBOOK_SECRET=

# ---- Optional: Slack (sign-in + channel import; mocked when ID is empty) ----
# Slack requires HTTPS redirect URLs, so real Slack only works on a deployed URL.
NEXT_PUBLIC_SLACK_ID=
SLACK_SECRET=
NEXT_PUBLIC_SLACK_APP_REDIRECT_URI=http://localhost:3000/slack-app
NEXT_PUBLIC_SLACK_DASHBOARD_REDIRECT_URI=http://localhost:3000/dashboard

# ---- Optional: Stripe (use test-mode keys; mocked when secret key is empty) --
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_RETURN_URL=http://localhost:3000/profile
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRODUCT_ID=

# ---- Optional: Postmark email (mocked when empty: emails are logged) --------
POSTMARK_API_KEY=
# Receives user feedback submissions
ADMIN_EMAIL=

# ---- Optional: analytics (no-op when empty) ----------------------------------
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# Used by next-sitemap at build time
SITE_URL=http://localhost:3000
