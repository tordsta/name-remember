FROM node:20-alpine

WORKDIR /app

COPY package.json yarn.lock ./
RUN corepack enable && yarn install --frozen-lockfile

COPY . .

# NEXT_PUBLIC_* values are inlined into the bundle at build time, so they are
# build args (CI passes them from GitHub repo variables). Empty values leave the
# integration mocked or disabled, see src/lib/integrations.ts.
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
ARG NEXT_PUBLIC_STRIPE_RETURN_URL=""
ARG NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=""
ARG NEXT_PUBLIC_AMPLITUDE_API_KEY=""
ARG NEXT_PUBLIC_SLACK_ID=""
ARG NEXT_PUBLIC_SLACK_APP_REDIRECT_URI=""
ARG NEXT_PUBLIC_SLACK_DASHBOARD_REDIRECT_URI=""
ARG SITE_URL=""

ENV NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY \
    NEXT_PUBLIC_STRIPE_RETURN_URL=$NEXT_PUBLIC_STRIPE_RETURN_URL \
    NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=$NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID \
    NEXT_PUBLIC_AMPLITUDE_API_KEY=$NEXT_PUBLIC_AMPLITUDE_API_KEY \
    NEXT_PUBLIC_SLACK_ID=$NEXT_PUBLIC_SLACK_ID \
    NEXT_PUBLIC_SLACK_APP_REDIRECT_URI=$NEXT_PUBLIC_SLACK_APP_REDIRECT_URI \
    NEXT_PUBLIC_SLACK_DASHBOARD_REDIRECT_URI=$NEXT_PUBLIC_SLACK_DASHBOARD_REDIRECT_URI \
    SITE_URL=$SITE_URL \
    NEXT_TELEMETRY_DISABLED=1

RUN yarn build

CMD [ "npm", "start" ]
