# Copy to secret.auto.tfvars (gitignored) and fill in. Only project_id is
# required: every integration left empty runs mocked or disabled.
project_id = "name-remember-26"

# OAuth sign-in. Callback: <service_url>/api/auth/callback/<provider>
GITHUB_ID     = ""
GITHUB_SECRET = ""
GOOGLE_ID     = ""
GOOGLE_SECRET = ""

# Slack (also set NEXT_PUBLIC_SLACK_ID as a GitHub repo variable)
NEXT_PUBLIC_SLACK_ID = ""
SLACK_SECRET         = ""

# Stripe test mode (also set NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY as a GitHub repo variable)
STRIPE_SECRET_KEY         = ""
STRIPE_WEBHOOK_SECRET     = ""
STRIPE_PREMIUM_PRODUCT_ID = ""

POSTMARK_API_KEY = ""
ADMIN_EMAIL      = ""
